###############################################
### EDGE CASES & VALIDATION TESTS
###############################################

### Test: Create Movie with Invalid Rating (should fail)
POST {{media_vault_app.API_HostAddress}}/MediaEntries/movies
Content-Type: application/json
Accept: application/json

{
  "title": "Test Movie",
  "review": "Testing validation",
  "releaseYear": 2024,
  "genres": ["Action"],
  "rating": 6.0,
  "status": "Planned",
  "runtimeMinutes": 120
}

###

### Test: Create Movie with Missing Required Title (should fail)
POST {{media_vault_app.API_HostAddress}}/MediaEntries/movies
Content-Type: application/json
Accept: application/json

{
  "review": "Missing title field",
  "releaseYear": 2024,
  "genres": ["Action"],
  "rating": 4.0,
  "status": "Planned",
  "runtimeMinutes": 120
}

###

### Test: Create Game with Negative Hours (edge case)
POST {{media_vault_app.API_HostAddress}}/MediaEntries/games
Content-Type: application/json
Accept: application/json

{
  "title": "Test Game",
  "review": "Testing negative hours",
  "releaseYear": 2024,
  "genres": ["Action"],
  "rating": 4.0,
  "status": "InProgress",
  "devStudioName": "Test Studio",
  "hoursPlayed": -10.0
}

###

### Test: Create Book without AuthorId (should fail for authored entries)
POST {{media_vault_app.API_HostAddress}}/MediaEntries/books
Content-Type: application/json
Accept: application/json

{
  "title": "Test Book",
  "review": "Missing author",
  "releaseYear": 2024,
  "genres": ["Fiction"],
  "rating": 4.0,
  "status": "Planned"
}

