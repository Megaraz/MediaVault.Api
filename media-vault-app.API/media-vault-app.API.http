@media_vault_app.API_HostAddress = https://localhost:7121
@username = jd
@email = testuser@example.com
@password = abc123
@updatedUsername = testuser-updated
@updatedEmail = testuser-updated@example.com

### Register
POST {{media_vault_app.API_HostAddress}}/Auth/register
Content-Type: application/json
Accept: application/json

{
  "username": "{{username}}",
  "email": "{{email}}",
  "confirmEmail": "{{email}}",
  "password": "{{password}}",
  "confirmPassword": "{{password}}"
}

###

### Login
POST {{media_vault_app.API_HostAddress}}/Auth/login
Content-Type: application/json
Accept: application/json

{
  "usernameOrEmail": "{{username}}",
  "password": "{{password}}"
}

###

### Get current user
GET {{media_vault_app.API_HostAddress}}/Auth/me
Accept: application/json

###

### Update current user
PUT {{media_vault_app.API_HostAddress}}/Auth
Content-Type: application/json
Accept: application/json

{
  "userName": "{{updatedUsername}}",
  "email": "{{updatedEmail}}"
}

###

### Logout
POST {{media_vault_app.API_HostAddress}}/Auth/logout
Accept: application/json

###

### TMDB - Search Movies
POST {{media_vault_app.API_HostAddress}}/TmdbApi/movie/search?page=1
Content-Type: application/json
Accept: application/json

{
  "query": "Inception"
}

###

### TMDB - Get Movie by ID
GET {{media_vault_app.API_HostAddress}}/TmdbApi/movie/550
Accept: application/json

###

### TMDB - Search TV Series
POST {{media_vault_app.API_HostAddress}}/TmdbApi/tv/search?page=1
Content-Type: application/json
Accept: application/json

{
  "query": "Breaking Bad"
}

###

### TMDB - Get TV Series by ID
GET {{media_vault_app.API_HostAddress}}/TmdbApi/tv/1396
Accept: application/json

###

###############################################
### MEDIA ENTRIES - TYPE-SPECIFIC ENDPOINTS
###############################################

@movieEntryId = 00000000-0000-0000-0000-000000000000
@tvSeriesEntryId = 00000000-0000-0000-0000-000000000000
@gameEntryId = 00000000-0000-0000-0000-000000000000
@bookEntryId = 00000000-0000-0000-0000-000000000000
@mangaEntryId = 00000000-0000-0000-0000-000000000000
@authorId = 00000000-0000-0000-0000-000000000000

###############################################
### CREATE OPERATIONS (Type-Specific Endpoints)
###############################################

### Create Movie Entry
# @name createMovie
POST {{media_vault_app.API_HostAddress}}/MediaEntries/movies
Content-Type: application/json
Accept: application/json

{
  "title": "Inception",
  "review": "A thief who steals corporate secrets through dream-sharing technology.",
  "releaseYear": 2010,
  "genres": ["Action", "Science Fiction", "Thriller"],
  "rating": 4.5,
  "imageUrl": "https://image.tmdb.org/t/p/w500/9gk7adHYeDvHkCSEqAvQNLV5Uge.jpg",
  "status": "Completed",
  "runtimeMinutes": 148
}

###

### Create TV Series Entry
# @name createTvSeries
POST {{media_vault_app.API_HostAddress}}/MediaEntries/tv-series
Content-Type: application/json
Accept: application/json

{
  "title": "Breaking Bad",
  "review": "A high school chemistry teacher turned meth manufacturer.",
  "releaseYear": 2008,
  "genres": ["Drama", "Crime", "Thriller"],
  "rating": 5.0,
  "imageUrl": "https://image.tmdb.org/t/p/w500/ggFHVNu6YYI5L9pCfOacjizRGt.jpg",
  "status": "Completed",
  "totalEpisodes": 62,
  "totalWatchedEpisodes": 62
}

###

### Create Game Entry
# @name createGame
POST {{media_vault_app.API_HostAddress}}/MediaEntries/games
Content-Type: application/json
Accept: application/json

{
  "title": "The Witcher 3: Wild Hunt",
  "review": "Epic RPG with monster hunting.",
  "releaseYear": 2015,
  "genres": ["RPG", "Action", "Adventure"],
  "rating": 5.0,
  "imageUrl": "https://images.igdb.com/igdb/image/upload/t_cover_big/co1wyy.jpg",
  "status": "InProgress",
  "devStudioName": "CD Projekt Red",
  "hoursPlayed": 127.5
}

###

### Create Book Entry (requires Author)
# @name createBook
POST {{media_vault_app.API_HostAddress}}/MediaEntries/books
Content-Type: application/json
Accept: application/json

{
  "title": "1984",
  "review": "A dystopian social science fiction novel.",
  "releaseYear": 1949,
  "genres": ["Dystopian", "Political Fiction"],
  "rating": 4.5,
  "imageUrl": "https://covers.openlibrary.org/b/id/7222246-L.jpg",
  "status": "Completed",
  "authorId": "{{authorId}}"
}

###

### Create Manga Entry (requires Author)
# @name createManga
POST {{media_vault_app.API_HostAddress}}/MediaEntries/manga
Content-Type: application/json
Accept: application/json

{
  "title": "Berserk",
  "review": "Dark fantasy manga with incredible artwork.",
  "releaseYear": 1989,
  "genres": ["Dark Fantasy", "Action", "Horror"],
  "rating": 5.0,
  "imageUrl": "https://upload.wikimedia.org/wikipedia/en/6/6b/Berserk_vol01_cover.jpg",
  "status": "InProgress",
  "authorId": "{{authorId}}"
}

###

###############################################
### READ OPERATIONS
###############################################

### Get All Media Entries (All Types)
GET {{media_vault_app.API_HostAddress}}/MediaEntries?pageNumber=1&pageSize=25
Accept: application/json

###

### Get Movie Entry by ID
GET {{media_vault_app.API_HostAddress}}/MediaEntries/{{movieEntryId}}
Accept: application/json

###

### Get TV Series Entry by ID
GET {{media_vault_app.API_HostAddress}}/MediaEntries/{{tvSeriesEntryId}}
Accept: application/json

###

### Get Game Entry by ID
GET {{media_vault_app.API_HostAddress}}/MediaEntries/{{gameEntryId}}
Accept: application/json

###

### Get Book Entry by ID
GET {{media_vault_app.API_HostAddress}}/MediaEntries/{{bookEntryId}}
Accept: application/json

###

### Get Manga Entry by ID
GET {{media_vault_app.API_HostAddress}}/MediaEntries/{{mangaEntryId}}
Accept: application/json

###

### Search Media Entries (Cross-type search)
POST {{media_vault_app.API_HostAddress}}/MediaEntries/search?page=1&pageSize=10
Content-Type: application/json
Accept: application/json

{
  "query": "Inception"
}

###

###############################################
### UPDATE OPERATIONS (Type-Specific Endpoints)
###############################################

### Update Movie Entry
PUT {{media_vault_app.API_HostAddress}}/MediaEntries/movies/{{movieEntryId}}
Content-Type: application/json
Accept: application/json

{
  "title": "Inception (Updated)",
  "review": "Mind-bending masterpiece",
  "releaseYear": 2010,
  "genres": ["Action", "Science Fiction", "Thriller"],
  "rating": 5.0,
  "imageUrl": "https://image.tmdb.org/t/p/w500/9gk7adHYeDvHkCSEqAvQNLV5Uge.jpg",
  "status": "Completed",
  "runtimeMinutes": 148
}

###

