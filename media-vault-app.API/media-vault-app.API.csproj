    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\media-vault-app.Application\media-vault-app.Application.csproj" />
    <ProjectReference Include="..\media-vault-app.Domain\media-vault-app.Domain.csproj" />
    <ProjectReference Include="..\media-vault-app.Infrastructure\media-vault-app.Infrastructure.csproj" />
  </ItemGroup>

