<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>media_vault_app.API</RootNamespace>
    <SpaRoot>..\media-vault-app.client</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:61366</SpaProxyServerUrl>
    <UserSecretsId>f4bdc0ef-0503-4d35-9a1c-19363d91e191</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy">
      <Version>10.*-*</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\media-vault-app.Application\media-vault-app.Application.csproj" />
    <ProjectReference Include="..\media-vault-app.Domain\media-vault-app.Domain.csproj" />
    <ProjectReference Include="..\media-vault-app.Infrastructure\media-vault-app.Infrastructure.csproj" />
  </ItemGroup>

</Project>
