<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>media_vault_app.API</RootNamespace>
    <UserSecretsId>f4bdc0ef-0503-4d35-9a1c-19363d91e191</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Megaraz.ResultPattern" Version="0.2.2" />
